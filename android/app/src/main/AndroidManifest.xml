<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".IofastApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Iofast">

        <!-- Home screen: capture status, side-key setup, links, problem log -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Trampoline: second launcher entry "iofast capture" for the side key.
             Reads the last URL, notifies, exits. Own empty task so it never
             brings the home screen forward over the page being captured. -->
        <activity
            android:name=".CaptureTrampolineActivity"
            android:exported="true"
            android:label="@string/capture_label"
            android:taskAffinity=""
            android:theme="@style/Theme.Iofast.Translucent"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share-sheet target: receives ACTION_SEND text/plain or text/uri-list -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Iofast.Translucent"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/uri-list" />
            </intent-filter>
        </activity>

        <!-- Transparent clipboard reader: launched after share-flow clicks Copy-link.
             Being focused allows clipboard read on Android 10+. -->
        <activity
            android:name=".ClipboardReadActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Iofast.Translucent"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- Pairing link from the PC: iofast://pair?key=<phone key>.
             Saves the key and checks the inbox answers. -->
        <activity
            android:name=".PairActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/pair_title">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="iofast" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Queue screen: list captured links with copy/share/delete -->
        <activity
            android:name=".QueueActivity"
            android:exported="false"
            android:label="@string/queue_title" />

        <!-- Accessibility service: tracks foreground app + URL bar / view tree -->
        <service
            android:name=".UrlCaptureAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>